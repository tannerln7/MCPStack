# Keep personal Stack inputs/installers local; track only the generic examples.
/config/stacks/*.yaml
!/config/stacks/stdio.yaml
!/config/stacks/http.yaml
!/config/stacks/application.yaml
!/config/stacks/composite.yaml
/config/environments/*/
!/config/environments/example-stdio/
/config/tunnel-profiles/*.yaml
!/config/tunnel-profiles/example-stdio.yaml
!/config/tunnel-profiles/example-http.yaml
/scripts/install-*-stack.sh
